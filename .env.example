GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CONTACT_FROM_EMAIL=ajarapmcpr@gmail.com
CONTACT_TO_EMAIL=ajarapmcpr@gmail.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only if your trusted ingress overwrites X-Forwarded-For.
CONTACT_TRUST_PROXY=false

# Payload CMS — local PostgreSQL 17; never use these placeholders as credentials
DATABASE_URL=postgresql://pmc_app:REPLACE_LOCALLY@127.0.0.1:5433/pmc_cms
PAYLOAD_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional override for a separate local verification port
# CMS_SERVER_URL=http://localhost:3000

# Optional CMS recovery email (independent of Gmail OAuth)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Optional production S3-compatible storage (DigitalOcean Spaces)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
