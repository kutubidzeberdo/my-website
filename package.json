{
  "name": "adjara-project-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "cms": "node --import tsx scripts/cms/run.ts",
    "cms:import": "node --import tsx scripts/cms/import.ts",
    "cms:bootstrap": "python3 scripts/cms/bootstrap.py",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/email-nodemailer": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/storage-s3": "3.92.0",
    "@payloadcms/translations": "3.92.0",
    "graphql": "16.14.2",
    "next": "^16.0.0",
    "payload": "3.92.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "type": "module",
  "overrides": {
    "dompurify": "3.4.17",
    "happy-dom": "21.0.4"
  }
}
